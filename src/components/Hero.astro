<section class="hero" id="top">
  <div class="hero-bg-gears" aria-hidden="true">
    <svg class="gear gear-1" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <use href="#gear-shape"/>
    </svg>
    <svg class="gear gear-2" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <use href="#gear-shape"/>
    </svg>
    <svg class="gear gear-3" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <use href="#gear-shape"/>
    </svg>
  </div>

  <!-- spray dots -->
  <div class="spray" aria-hidden="true">
    <span class="s s1"></span><span class="s s2"></span><span class="s s3"></span>
    <span class="s s4"></span><span class="s s5"></span><span class="s s6"></span>
    <span class="s s7"></span><span class="s s8"></span>
  </div>

  <div class="hero-inner container">
    <div class="day-badge">EVERY FRIDAY</div>
    <h1 class="hero-title">
      <span class="title-golden">ゴールデン</span><br>
      <span class="title-besiege">Besiege</span><br>
      <span class="title-time">タイム</span>
    </h1>
    <p class="hero-sub">毎週金曜日はBesiegeの日！！！</p>
    <div class="hero-catchcopy">
      <p>遊んで、撮って、投稿する。</p>
      <p>みんなで金曜を<strong>Besiege色</strong>にしていく企画です。</p>
      <p>遊ぶ・投稿する・見るを同時に動かして、界隈をもっと盛り上げていきましょう。</p>
    </div>
    <div class="hero-tags">
      <span class="htag">#ゴールデンBesiegeタイム</span>
      <span class="htag">#FridayBesiege</span>
    </div>
  </div>

  <div class="hero-bottom-bar" aria-hidden="true"></div>
</section>

<!-- Reusable gear SVG def -->
<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <symbol id="gear-shape" viewBox="0 0 100 100">
      <path d="M43.3,5.6l-2.7,8.4c-2.6,0.6-5,1.5-7.3,2.7l-7.7-4.6l-9.7,9.7l4.6,7.7c-1.2,2.3-2.1,4.7-2.7,7.3l-8.4,2.7v13.7l8.4,2.7c0.6,2.6,1.5,5,2.7,7.3l-4.6,7.7l9.7,9.7l7.7-4.6c2.3,1.2,4.7,2.1,7.3,2.7l2.7,8.4h13.7l2.7-8.4c2.6-0.6,5-1.5,7.3-2.7l7.7,4.6l9.7-9.7l-4.6-7.7c1.2-2.3,2.1-4.7,2.7-7.3l8.4-2.7V43.3l-8.4-2.7c-0.6-2.6-1.5-5-2.7-7.3l4.6-7.7l-9.7-9.7l-7.7,4.6c-2.3-1.2-4.7-2.1-7.3-2.7L56.7,5.6H43.3z M50,34c8.8,0,16,7.2,16,16s-7.2,16-16,16s-16-7.2-16-16S41.2,34,50,34z"/>
    </symbol>
  </defs>
</svg>

<style>
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(255,107,0,0.18) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 100%, rgba(139,58,15,0.2) 0%, transparent 50%),
    linear-gradient(170deg, #0e0b07 60%, #1a1208 100%);
  padding: 6rem 0 4rem;
}

/* Gears */
.hero-bg-gears {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.gear {
  position: absolute;
  fill: rgba(139,58,15,0.12);
  animation: spin linear infinite;
}

.gear-1 { width: 340px; height: 340px; top: -100px; right: -80px; animation-duration: 60s; }
.gear-2 { width: 180px; height: 180px; bottom: 40px; left: -40px; animation-duration: 40s; animation-direction: reverse; }
.gear-3 { width: 110px; height: 110px; bottom: 120px; left: 120px; animation-duration: 25s; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Spray paint dots */
.spray { position: absolute; inset: 0; pointer-events: none; }
.s {
  position: absolute;
  border-radius: 50%;
  filter: blur(3px);
}
.s1  { width:12px;height:12px; background:var(--color-orange); opacity:.35; top:15%; left:8%; }
.s2  { width:6px;height:6px;  background:var(--color-gold);   opacity:.5;  top:18%; left:11%; }
.s3  { width:18px;height:18px;background:var(--color-orange); opacity:.2;  top:70%; right:5%; }
.s4  { width:8px;height:8px;  background:var(--color-red);    opacity:.4;  top:60%; right:12%; }
.s5  { width:4px;height:4px;  background:var(--color-gold);   opacity:.6;  top:65%; right:8%; }
.s6  { width:14px;height:14px;background:var(--color-rust);   opacity:.3;  top:30%; right:20%; }
.s7  { width:5px;height:5px;  background:var(--color-orange); opacity:.5;  top:82%; left:30%; }
.s8  { width:9px;height:9px;  background:var(--color-gold);   opacity:.35; top:85%; left:60%; }

/* Content */
.hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
}

.day-badge {
  display: inline-block;
  font-family: var(--font-display-en);
  font-size: clamp(0.9rem, 2vw, 1.1rem);
  letter-spacing: 0.35em;
  color: var(--color-gold);
  border: 2px solid var(--color-gold);
  padding: 0.3em 1.2em;
  margin-bottom: 1.5rem;
  position: relative;
  text-transform: uppercase;
}

.day-badge::before,
.day-badge::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 2rem;
  height: 2px;
  background: var(--color-gold);
  opacity: 0.5;
}
.day-badge::before { right: calc(100% + 0.5rem); }
.day-badge::after  { left: calc(100% + 0.5rem); }

.hero-title {
  line-height: 0.9;
  margin-bottom: 1.5rem;
}

/* ゴールデン・タイム → mixed（日本語部分はDela Gothic One） */
.title-golden {
  display: block;
  font-family: var(--font-display-mixed);
  font-size: clamp(2.5rem, 8vw, 5rem);
  color: var(--color-gold);
  text-shadow:
    3px 3px 0 #8b3a0f,
    6px 6px 0 rgba(139,58,15,0.4);
  letter-spacing: 0.05em;
}

/* Besiege → Bangers（英語） */
.title-besiege {
  display: block;
  font-family: var(--font-display-en);
  font-size: clamp(4rem, 15vw, 9rem);
  color: var(--color-orange);
  text-shadow:
    3px 3px 0 #cc2200,
    6px 6px 0 rgba(204,34,0,0.3),
    0 0 40px rgba(255,107,0,0.4);
  letter-spacing: -0.02em;
  -webkit-text-stroke: 2px rgba(255,150,0,0.3);
}

/* タイム → mixed */
.title-time {
  display: block;
  font-family: var(--font-display-mixed);
  font-size: clamp(2rem, 7vw, 4.5rem);
  color: var(--color-cream);
  text-shadow:
    2px 2px 0 var(--color-stone),
    4px 4px 0 rgba(0,0,0,0.5);
  letter-spacing: 0.15em;
}

.hero-sub {
  font-family: var(--font-display-mixed);
  font-size: clamp(1.2rem, 3.5vw, 1.8rem);
  color: var(--color-orange-light);
  letter-spacing: 0.08em;
  margin-bottom: 1.5rem;
}

.hero-catchcopy {
  max-width: 560px;
  margin: 0 auto 2rem;
  font-size: clamp(0.9rem, 2vw, 1.05rem);
  color: var(--color-text-muted);
  line-height: 1.9;
}

.hero-catchcopy strong {
  color: var(--color-orange-light);
  font-weight: 700;
}

.hero-tags {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.htag {
  font-family: var(--font-display-mixed);
  font-size: clamp(0.85rem, 2vw, 1rem);
  color: var(--color-bg);
  background: var(--color-orange);
  padding: 0.35em 1em;
  letter-spacing: 0.05em;
  position: relative;
  clip-path: polygon(0.6rem 0%,calc(100% - 0.6rem) 0%,100% 50%,calc(100% - 0.6rem) 100%,0.6rem 100%,0% 50%);
}

/* Bottom accent bar */
.hero-bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, transparent 0%, var(--color-rust) 15%, var(--color-orange) 40%, var(--color-gold) 50%, var(--color-orange) 60%, var(--color-rust) 85%, transparent 100%);
}
</style>
